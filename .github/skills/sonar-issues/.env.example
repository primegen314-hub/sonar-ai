# sonar-issues pipeline configuration
# Copy this file to `.env` IN THIS SAME FOLDER (.github/skills/sonar-issues/.env).
# It is git-ignored and deliberately separate from any .env the host repository has
# at its root - the two never interfere.
# Single file holds secrets AND settings, by design.
#
# The sections below tell you exactly WHEN each variable matters:
#   1. REQUIRED BEFORE FIRST RUN            - fill these before /sonar-init (any mode)
#   2. REQUIRED BEFORE FIRST RUN (github)   - additionally, for GitHub mode only
#   3. SET AUTOMATICALLY DURING THE SESSION - the scripts write these; do not edit
#   4. OPTIONAL                             - sensible defaults; change only if needed

# ============================================================================
# 1. REQUIRED BEFORE FIRST RUN
# ============================================================================
# Your SonarQube server URL (pasting a full Sonar issues URL into /sonar-init
# also fills this in for the run).
SONAR_HOST=https://sonar.example.com
# LDAP username - used ONCE by s01 to mint a user token, then only the token is used.
SONAR_USER=
# Leave EMPTY to be prompted interactively (recommended - the password never touches
# disk). If you do set it, s01 automatically clears it after minting the token.
SONAR_PASSWORD=

# ============================================================================
# 2. REQUIRED BEFORE FIRST RUN - GITHUB MODE ONLY
#    (local mode needs none of these; set them via `python set_mode.py github`,
#     which prompts for the token with hidden input and derives org/repo from
#     the git remote when possible - or from a pasted repo URL when there is
#     no checkout at all)
# ============================================================================
# Needs WRITE access to the repository - /publish-to-github commits through the
# API (classic token: 'repo' scope; fine-grained: Contents read/write).
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_REPO=

# ============================================================================
# 3. SET AUTOMATICALLY DURING THE SESSION - do not edit by hand
# ============================================================================
# local | github - chosen ONCE in /sonar-init via set_mode.py ("remote" is a
# permanently accepted alias for "github" in old .env files).
#   local  = fixes edit the git checkout; tests run locally via /sonar-verify
#   github = no checkout needed; fixes go to SONAR_ISSUES/<branch>/_workspace/ +
#            changes.patch and are pushed with /publish-to-github; tests run in CI
WORKFLOW_MODE=
# Derived from WORKFLOW_MODE (local -> local, github -> github). Internal knob for
# where extraction reads source code from; set_mode.py keeps it consistent.
CONTEXT_SOURCE=
# Auto-generated and written back here by steps/s01_setup_auth.py.
SONAR_TOKEN=
# Local mode only: the Sonar-side branch name when Sonar names the branch
# differently than git (set via `python set_mode.py --sonar-branch <name>`).
SONAR_BRANCH=
# Persisted by `python verify.py --set-command "<cmd>"` the first time
# /sonar-verify runs (asked once, reused forever). Verification is always
# user-invoked - no skill runs tests automatically.
TEST_COMMAND=

# ============================================================================
# 4. OPTIONAL - sensible defaults
# ============================================================================
# Default project when no Sonar URL is pasted (the `id=` value from the Sonar URL).
SONAR_PROJECT_KEY=
# Set to false if the internal Sonar certificate is not trusted by this machine.
SONAR_VERIFY_SSL=true
# new_code = only the branch's New Code period (default) | all = whole codebase
SCOPE=new_code
# Comma-separated: OPEN, CONFIRMED, ACCEPTED, FALSE_POSITIVE, FIXED
ISSUE_STATUSES=OPEN,CONFIRMED
# Local mode: verify the checkout is in sync with origin before extracting (Sonar
# analyzed the pushed state). Set to false only when offline / no remote.
SYNC_CHECK=true
# Optional compile/build command used when an issue has no known test files.
BUILD_COMMAND=
# API base: default https://api.github.com | GitHub Enterprise: https://<host>/api/v3
GITHUB_API_URL=
# Only set when the branch is named differently on GitHub than in Sonar
# (by convention they are identical; the pipeline errors if the branch is missing).
GITHUB_BRANCH=
